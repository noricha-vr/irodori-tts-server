# Mac Studio ローカル常駐用の設定（秘密情報なし）。`.env` はこのファイルへの symlink（scripts/setup-local.sh）。
# Server
IRODORI_HOST=127.0.0.1
IRODORI_PORT=2618
IRODORI_MODEL_NAME=irodori-tts

# Model
IRODORI_HF_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small
# MeanFlow 蒸留版（4 steps 自動）へ切り替える時はこちらを有効化して launchctl kickstart -k
# IRODORI_HF_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small-MF
IRODORI_CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
IRODORI_MODEL_DEVICE=mps
IRODORI_CODEC_DEVICE=mps
IRODORI_MODEL_PRECISION=fp32
IRODORI_CODEC_PRECISION=fp32
IRODORI_COMPILE_MODEL=false
# 起動時にモデルをロードしておき、通知の初回コールドスタートを無くす
IRODORI_PRELOAD=true
IRODORI_MODEL_LOAD_TIMEOUT=600
# MPS は並列合成で落ちるので 1 固定
IRODORI_MAX_CONCURRENT_SYNTHESIS=1
IRODORI_SYNTHESIS_WAIT_TIMEOUT=300
IRODORI_EMPTY_CACHE_INTERVAL=10

# Voices（絶対パス必須。voices/voices.json が Ellis を skill 側 wav へエイリアス）
IRODORI_VOICES_DIR=/Users/ms25/project/irodori-tts-server/voices
IRODORI_DEFAULT_VOICE=Ellis
IRODORI_ALLOW_NO_REF_VOICE=true

# Defaults for /v1/audio/speech
IRODORI_DEFAULT_RESPONSE_FORMAT=wav
IRODORI_DEFAULT_T_SCHEDULE_MODE=linear
IRODORI_DEFAULT_SWAY_COEFF=-1.0
IRODORI_DEFAULT_DURATION_SCALE=1.0
IRODORI_DEFAULT_CFG_SCALE_TEXT=3.0
IRODORI_DEFAULT_CFG_SCALE_SPEAKER=5.0
IRODORI_DEFAULT_CFG_GUIDANCE_MODE=independent
IRODORI_DEFAULT_CHUNKING_ENABLED=true
IRODORI_DEFAULT_CHUNK_MIN_CHARS=100
